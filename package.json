{
  "name": "welcome-to-raanana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "predev": "node scripts/ingest.mjs && python3 scripts/gen-icons.py && node scripts/gen-og.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/ingest.mjs && python3 scripts/gen-icons.py && node scripts/gen-og.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@ai-sdk/react": "^4.0.86",
    "@hebcal/core": "^6.9.2",
    "ai": "^7.0.83",
    "leaflet": "^1.9.4",
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^9.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "satori": "^0.33.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.2"
  }
